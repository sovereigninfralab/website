# Cloudflare Pages response headers. The site uses no JavaScript, no external
# fonts and no third-party requests, so the Content Security Policy is strict.
# If Cloudflare Web Analytics is ever enabled, add
#   script-src https://static.cloudflareinsights.com; connect-src https://cloudflareinsights.com
# and update the privacy notice first.

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'none'; style-src 'self'; img-src 'self'; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), browsing-topics=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8

# Keep preview and *.pages.dev copies out of search engines; only the custom domain is indexed.
https://:project.pages.dev/*
  X-Robots-Tag: noindex
