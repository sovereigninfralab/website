// Cloudflare Workers static-assets configuration for the SISL website.
// The site is plain files in ./site; there is no Worker script and no build step.
// Cloudflare Workers Builds runs `npx wrangler deploy` on every push to main.
{
  "name": "website",
  "compatibility_date": "2026-11-23",
  // Serve the site only on its custom domains (sovereigninfralab.com and www).
  // No copy at website.<account>.workers.dev.
  "workers_dev": false,
  // No public Version URLs for individual uploads.
  "preview_urls": false,
  "assets": {
    "directory": "./site",
    // Serve site/404.html, with HTTP status 404, for paths that do not exist.
    "not_found_handling": "404-page",
    // /about and /about/ both serve site/about/index.html.
    "html_handling": "auto-trailing-slash"
  },
  // Branch Previews for pull requests. Workers Builds runs `wrangler preview` for
  // branches other than main, which needs this block. Previews have their own
  // settings and do not inherit the production settings above.
  "previews": {}
}
